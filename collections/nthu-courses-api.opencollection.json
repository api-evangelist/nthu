                "value": "",
                "type": "query",
                "description": "授課語言"
              },
              {
                "name": "note",
                "value": "",
                "type": "query",
                "description": "備註"
              },
              {
                "name": "suspend",
                "value": "",
                "type": "query",
                "description": "停開註記"
