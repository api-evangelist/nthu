{
  "opencollection": "1.0.0",
  "info": {
    "name": "NTHU Data Announcements Courses API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Courses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Courses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nthusa.tw/courses/"
          },
          "docs": "取得所有課程。\n資料來源：[教務處課務組/JSON格式下載](https://curricul.site.nthu.edu.tw/p/406-1208-111356,r7883.php?Lang=zh-tw)"
        },
        {
          "info": {
            "name": "Search Courses By Field And Value",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nthusa.tw/courses/search",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "課號"
              },
              {
                "name": "chinese_title",
                "value": "",
                "type": "query",
                "description": "課程中文名稱"
