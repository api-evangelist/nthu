          "name": "Get Bus Schedules",
          "request": {
            "name": "Get Bus Schedules",
            "description": {
              "content": "取得指定條件的公車時刻表。\n- **details=False**: 回傳簡易時刻表（僅發車時間）。\n- **details=True**: 回傳詳細時刻表（包含每站預估到達時間）。",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "buses",
                "schedules"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bus_type",
                  "value": "<string>",
                  "description": "(Required) 車種選擇"
                },
                {
                  "disabled": false,
                  "key": "day",
                  "value": "<string>",
                  "description": "(Required) 平日、假日或目前時刻"
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "<string>",
                  "description": "(Required) 上山或下山"
                },
                {
                  "disabled": false,
                  "key": "details",
                  "value": "false",
                  "description": "是否包含詳細站點時間資訊"
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<string>",
                  "description": "時間。若搜尋 day 選擇 current 時失效。"
                },
                {
                  "disabled": false,
                  "key": "limits",
                  "value": "5",
                  "description": "最大回傳資料筆數。預設為 5 筆，可以透過查詢參數調整。"
